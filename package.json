{
  "name": "@kikulmj/dsh-jupyter",
  "description": "Jupyter notebook (.ipynb) viewer, editor and runner for the dsh web GUI: a native right-sidebar tab type driven by the host filesystem service, with a stdlib-only Python kernel bridge that uses dsh's bundled Python. No native dependencies.",
  "version": "0.2.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikulmj/dsh-jupyter.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types-client/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs",
    "examples"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -b tsconfig.host.json tsconfig.client.json && tsdown && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json --pretty false"
  }
}
